/*
 * V2 on the Mac (PREREGISTRATION.md; coordinator/user rules 2026-11-14): one task at a
 * time, so one container; at most 8 GB and 4 cores. Run-time limits only: no
 * results-affecting parameter is set here.
 */
executor { cpus = 4; memory = '8 GB'; queueSize = 1 }
process {
    resourceLimits = [ cpus: 4, memory: 8.GB, time: 6.h ]
    withName: 'HOSTILE_CLEAN'  { cpus = 4; memory = 5.GB }
    withName: 'FASTP|RGI_BWT'  { cpus = 2; memory = 2.5.GB }
    withName: 'RGI_CARDANNOTATION' { memory = 1.GB }
    withName: 'RGI_DB'         { memory = 4.GB }
    withName: 'DIAMOND_BLASTX' { cpus = 4; memory = 3.GB }
    withName: 'DIAMOND_DB'     { cpus = 2; memory = 2.GB }
    withName: 'SORTMERNA_INDEX|COUNT_16S' { cpus = 2; memory = 1.5.GB }
}
docker.runOptions = '-u $(id -u):$(id -g) --memory=8g'
