/*
 * V1 on a laptop: fit Docker Desktop's memory (11.7 GB on the author's Mac).
 * The local executor never runs more tasks at once than fit these totals.
 * hostile's bowtie2 needs about 4 GB for the human T2T index.
 */
executor {
    cpus   = 8
    memory = '11 GB'
}
process {
    resourceLimits = [ cpus: 8, memory: 10.GB, time: 4.h ]
    withName: 'HOSTILE_CLEAN' {
        cpus   = 4
        memory = 6.GB
    }
}
