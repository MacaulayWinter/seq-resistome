/*
 * V1 on a laptop: fit Docker Desktop's memory (11.7 GB on the author's Mac).
 * The local executor never runs more tasks at once than fit these totals.
 * hostile's bowtie2 needs about 4 GB for the human T2T index.
 */
executor {
    cpus   = 8
    memory = '9 GB'   // leaves room for other Docker work on the same Mac
}
process {
    resourceLimits = [ cpus: 8, memory: 10.GB, time: 4.h ]
    withName: 'HOSTILE_CLEAN' {
        cpus   = 4
        memory = 5.GB
    }
    // Requests sized to the peaks measured on a 2.3-million-read mixture
    // (timing run, 2026-10-28: fastp 1.3 GB, RGI 1.1 GB, SortMeRNA 0.55 GB),
    // with headroom; the local executor schedules by request, so the
    // defaults (8 GB) let only one such task run at a time.
    withName: 'FASTP|RGI_BWT' {
        cpus   = 2
        memory = 2.5.GB
    }
    // SORTMERNA_INDEX peaks at 0.8 GB; at its default 8 GB request it was
    // never scheduled while smaller tasks kept the memory busy (V1 run 1).
    withName: 'SORTMERNA_INDEX|COUNT_16S' {
        cpus   = 2
        memory = 1.5.GB
    }
}
