// Unattended development run on the Mac: one task (one container) at a time,
// at most 8 GB and 4 cores. Resources only; nothing here changes results.
executor { cpus = 4; memory = 8.GB; queueSize = 1 }
process {
    resourceLimits = [ cpus: 4, memory: 8.GB, time: 4.h ]
    withName: 'DIAMOND_BLASTX' { memory = 6.GB }   // not yet measured at full size
}
docker.runOptions = '-u $(id -u):$(id -g) --memory=8g'   // hard cap per container
