/*
 * E4 on a laptop. seq-triage's Kraken2 step asks for 10 GB by default; with
 * --kraken2_memory_mapping the database is read from disk, so 8 GB is
 * plenty, and the run fits Docker Desktop's 11.7 GB.
 */
executor {
    cpus   = 8
    memory = '11 GB'
}
process {
    resourceLimits = [ cpus: 8, memory: 10.GB, time: 4.h ]
    withName: 'KRAKEN2|KRAKEN2_BATCH' {
        memory = 8.GB
    }
}
