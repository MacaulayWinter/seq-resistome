/* E4 on the Mac: seq-triage's Kraken2 reads its database from disk (memory mapping), 8 GB; one task at a time, 4 cores. */
executor { cpus = 4; memory = '8 GB'; queueSize = 1 }
process {
    resourceLimits = [ cpus: 4, memory: 8.GB, time: 6.h ]
    withName: 'KRAKEN2|KRAKEN2_BATCH' { memory = 8.GB }
}
docker.runOptions = '-u $(id -u):$(id -g) --memory=8g'
