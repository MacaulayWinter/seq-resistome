/*
 * seq-resistome: test_variants profile (D20)
 *
 * The test profile with CARD's variants collection switched on, as in a
 * default run: downloads (once, into the CARD cache) and indexes the 1.8 GB
 * collection, so it needs ~10 GB of free disk and 8 GB of memory.
 *
 *   nextflow run main.nf -profile test_variants,docker
 */
includeConfig 'test.config'

params {
    card_variants = true
}

process {
    resourceLimits = [ cpus: 4, memory: 8.GB, time: 2.h ]
}
