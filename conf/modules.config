/*
 * seq-resistome: per-process options (ext.args) and where outputs are published
 *
 * Modules never hard-code arguments or output paths; nf-core modules read
 * task.ext.args, and publishDir is set here, so all of it is in one place.
 * Reads are never published, by any step (hard rule; the e2e check tests it).
 */

process {

    publishDir = [ enabled: false ]

    // Merged lanes are working files.
    withName: 'CAT_FASTQ' {
        publishDir = [ enabled: false ]
    }

    // fastp with its defaults (adapters, quality, length 15); its reports only.
    withName: 'FASTP' {
        publishDir = [ path: { "${params.outdir}/fastp" }, mode: params.publish_dir_mode, pattern: '*.{json,html}' ]
    }

    // D6: a hostile standard index is fetched once into the cache and kept
    // there between runs (storeDir: the task is skipped when the folder
    // already holds it). One folder per index name.
    withName: 'HOST_FETCH' {
        storeDir = { "${params.host_cache ?: System.getProperty('user.home') + '/.seq-resistome/hostile'}/${params.host_index}" }
    }
    // Short reads always use bowtie2: hostile otherwise treats single-end
    // files as long reads and uses minimap2 (found while building, D6).
    withName: 'HOSTILE_CLEAN' {
        ext.args   = '--aligner bowtie2'
        publishDir = [ path: { "${params.outdir}/host_removal" }, mode: params.publish_dir_mode, pattern: '*.json' ]
    }

    // D8: kma, RGI's recommended aligner, named so an RGI update cannot
    // change it silently. CARD's protein homolog models only (RGI's default
    // without --include_other_models). The gene and allele tables and the
    // overall mapping statistics are published; RGI's BAM files never are.
    withName: 'RGI_BWT' {
        ext.args2  = '--aligner kma'
        publishDir = [ path: { "${params.outdir}/rgi" }, mode: params.publish_dir_mode,
                       pattern: '*{gene_mapping_data,allele_mapping_data,overall_mapping_stats}.txt' ]
    }

    withName: 'COUNT_16S' {
        publishDir = [ path: { "${params.outdir}/16s" }, mode: params.publish_dir_mode ]
    }

    // The tables and the summary: the top of the results folder.
    withName: 'RESISTOME_TABLES' {
        publishDir = [ path: { "${params.outdir}" }, mode: params.publish_dir_mode ]
    }
}
