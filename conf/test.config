/*
 * seq-resistome: test profile (CLAUDE.md D10)
 *
 * The whole pipeline on four small public samples (~15 MB, nf-core
 * test-datasets pinned by commit). Each tests one path:
 *   minigut         reads simulated from B. fragilis and E. coli K-12:
 *                   ARGs and 16S found; a shared-domain hit (rmtH) is
 *                   correctly not called detected (D8)
 *   mock_community  reads simulated from eight genomes, mostly
 *                   A. baumannii (CP009257), with P. aeruginosa, S. aureus,
 *                   Listeria, E. coli ...: many ARGs, including
 *                   A. baumannii's intrinsic OXA-51-like beta-lactamase
 *                   (nf-core's file name says B. fragilis; the read names
 *                   say otherwise, checked 2026-10-28)
 *   host_only       human mitochondrial reads, single-end: every read is host,
 *                   so nothing is left; zero ARGs, 16S missing (never infinite)
 *   virus_only      SARS-CoV-2 reads: reads left, but no ARGs and no 16S
 *
 *   nextflow run main.nf -profile test,docker            (Linux, CI)
 *   nextflow run main.nf -profile test,docker,arm64      (Apple Silicon)
 */

params {
    input      = "${projectDir}/assets/samplesheet_test.csv"
    outdir     = 'results'
    // Host removal PLUMBING: the human mitochondrial genome (rCRS, 17 kb)
    // stands in for the host, so CI does not fetch hostile's 4 GB human
    // index. Host removal accuracy belongs to hostile's own validation.
    host_fasta = 'https://raw.githubusercontent.com/nf-core/test-datasets/53cf177d0dfd0512d0c0a2ec4a74c19b569e19fd/data/genomics/homo_sapiens/genome/human_mt_rCRS.fasta'
}

process {
    // Fit a GitHub Actions runner (4 CPUs, 16 GB) and Docker on the
    // author's Mac (11.7 GB).
    resourceLimits = [ cpus: 4, memory: 6.GB, time: 1.h ]
}
