/*
 * seq-resistome: main configuration
 *
 * Read top to bottom: what the pipeline is (manifest), what it accepts
 * (params), what it depends on (plugins), how it runs (profiles), and what it
 * records about each run (reports). Resource settings live in conf/base.config.
 */

manifest {
    name            = 'MacaulayWinter/seq-resistome'
    description     = 'Antibiotic resistance genes in shotgun metagenomes: read-based counts against CARD, normalised, with denominators'
    homePage        = 'https://github.com/MacaulayWinter/seq-resistome'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    version         = '0.1.0dev'
    // '!' makes this a hard requirement. CI pins the exact version with NXF_VER.
    nextflowVersion = '!>=26.10.0'
    contributors    = [
        [ name: 'Macaulay Winter', github: 'MacaulayWinter', contribution: ['author', 'maintainer'] ]
    ]
}

params {
    // Inputs
    input           = null      // samplesheet CSV: sample, fastq_1, fastq_2, then any study metadata columns
    triage_results  = null      // a seq-triage --outdir: only its PASS/WARN short-read metagenomes are analysed (D9)

    // CARD (D1, D5). Downloaded once from card.mcmaster.ca into the cache and
    // checked against its checksum on every run; never stored in this repository.
    card_cache      = null      // null: ~/.seq-resistome/card
    card_version    = 'validated'   // 'validated' (the CARD release this version was validated with) or 'latest'
    card_versions   = "${projectDir}/assets/card_versions.csv"

    // Host removal with hostile (D6). Human by default.
    host_index      = 'human-t2t-hla'   // a hostile standard index, fetched once into host_cache
    host_cache      = null      // null: ~/.seq-resistome/hostile
    host_fasta      = null      // your own host genome instead (FASTA); indexed with bowtie2 on each run
    skip_host_removal = false   // true for samples with no host (e.g. water, soil)

    // 16S rRNA denominator (D7): SortMeRNA against SILVA 16S as shipped by
    // SortMeRNA 4.3.7 (bacteria 90%, archaea 95% identity clusters), pinned by tag.
    rrna_16s        = 'https://raw.githubusercontent.com/sortmerna/sortmerna/v4.3.7/data/rRNA_databases/silva-bac-16s-id90.fasta,https://raw.githubusercontent.com/sortmerna/sortmerna/v4.3.7/data/rRNA_databases/silva-arc-16s-id95.fasta'
    length_16s      = 1542      // bp, E. coli rrsB (J01695): the gene length one 16S copy is counted as

    // When an ARG counts as detected (D8): enough reads, spread along the gene
    // as reads that land at random would be (not piled on one shared domain).
    min_arg_reads   = 2
    min_breadth_ratio = 0.5

    // Outputs
    outdir           = 'results'
    publish_dir_mode = 'copy'   // copy, not symlink: results survive deleting work/
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

plugins {
    // The version seq-triage pins (its D16): nf-core code targets 2.x.
    id 'nf-schema@2.8.0'
}

// Fail, don't warn, on a parameter the schema does not know (a typo such as
// --outdr would otherwise be ignored). Samplesheet columns are checked by
// main.nf instead (D4): unknown columns are study metadata, carried through.
validation {
    logging {
        unrecognisedParams  = 'error'
        unrecognisedHeaders = 'skip'
    }
    help {
        enabled    = true
        command    = "nextflow run MacaulayWinter/seq-resistome -profile docker --input samplesheet.csv --outdir results"
        beforeText = "seq-resistome: antibiotic resistance genes in shotgun metagenomes (read-based, CARD).\n"
        afterText  = "\nSamplesheet columns: sample, fastq_1, fastq_2, then any study metadata (README: Usage).\nApple Silicon: -profile docker,arm64. HPC without containers: -profile conda,slurm.\nCARD is free for non-commercial research use only (README: Licences).\n"
    }
}

// nf-core modules name containers relative to a registry.
docker.registry = 'quay.io'

profiles {
    docker {
        docker.enabled    = true
        conda.enabled     = false
        // Run as your own user so output files are not owned by root.
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    // Apple Silicon: native arm64 images where they exist (nf-core's generated
    // map), Rosetta emulation for the rest. Use AFTER docker: -profile docker,arm64.
    // The platform is stated for every process, so Docker cannot quietly
    // reuse an image of the other architecture already on disk (seq-triage D44).
    arm64 {
        includeConfig 'conf/containers_docker_arm64.config'
        docker.runOptions = '-u $(id -u):$(id -g)'
        process {
            containerOptions = '--platform=linux/arm64'
            // nf-core's map has no arm64 entry for RGI_CARDANNOTATION, but
            // it uses the same rgi_kma image as RGI_BWT, which has one.
            withName: 'RGI_CARDANNOTATION' {
                container = 'community.wave.seqera.io/library/rgi_kma:fab5219836c1d880'
            }
            // amd64-only images (checked 2026-10-28).
            withName: 'HOSTILE_FETCH|HOSTILE_CLEAN|HOST_INDEX|SORTMERNA_INDEX|COUNT_16S|UNTAR|CAT_FASTQ' {
                containerOptions = '--platform=linux/amd64'
            }
        }
    }
    // Machines without Docker, Apptainer or Singularity (many HPCs). Each
    // process builds its environment from its pinned environment.yml.
    // Set NXF_CONDA_CACHEDIR to keep the environments between runs.
    conda {
        conda.enabled       = true
        docker.enabled      = false
        conda.channels      = [ 'conda-forge', 'bioconda' ]
        conda.createTimeout = '1 h'
    }
    // Submit each task as a SLURM job. Cluster settings (account, partition)
    // never go in this repository: put them in your own config and add it
    // with -c (process.queue, process.clusterOptions).
    slurm {
        process.executor         = 'slurm'
        executor.queueSize       = 50
        executor.submitRateLimit = '10/1min'
    }
    // End-to-end test on small public samples (D10).
    test {
        includeConfig 'conf/test.config'
    }
}

// Run records. Overwritten, so the latest run is always in the same place.
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}
dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}
